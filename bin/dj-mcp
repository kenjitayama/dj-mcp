#!/usr/bin/env node
// CLI over lib/core.mjs. Prints JSON to stdout; exit 1 on error.
// Usage: dj-mcp <tool> [--json '{"k":"v"}' | '{"k":"v"}' | --key value ...]
//        dj-mcp tools      (list tools)
import { createCore, errorPayload } from '../lib/core.mjs';

const argv = process.argv.slice(2);
const out = (o) => process.stdout.write(JSON.stringify(o, null, 2) + '\n');

function parseValue(v) {
  try {
    return JSON.parse(v);
  } catch {
    return v;
  }
}

function parseArgs(rest) {
  let args = {};
  for (let i = 0; i < rest.length; i++) {
    const a = rest[i];
    if (a === '--json') {
      Object.assign(args, JSON.parse(rest[++i] ?? '{}'));
    } else if (a.startsWith('--')) {
      const eq = a.indexOf('=');
      const key = (eq > 0 ? a.slice(2, eq) : a.slice(2)).replace(/-/g, '_');
      const raw = eq > 0 ? a.slice(eq + 1) : rest[++i];
      // keep URLs, codes, ids as strings; parse numbers/booleans/arrays/objects
      args[key] = /^(redirect_url|url|code|state|query|device_id|device_name|name|description|playlist_id|uri|context_uri)$/.test(key) ? raw : parseValue(raw);
    } else if (a.trim().startsWith('{')) {
      Object.assign(args, JSON.parse(a));
    } else {
      throw new Error(`Unexpected argument: ${a}`);
    }
  }
  return args;
}

async function main() {
  const core = createCore();
  const cmd = argv[0];
  if (!cmd || cmd === 'help' || cmd === '--help' || cmd === '-h' || cmd === 'tools') {
    out({ usage: "dj-mcp <tool> [--json '{...}'] [--key value]", tools: core.tools.map((t) => ({ name: t.name, description: t.description, params: Object.keys(t.inputSchema.properties || {}) })) });
    return 0;
  }
  let args;
  try {
    args = parseArgs(argv.slice(1));
  } catch (e) {
    out({ error: { code: 'invalid_argument', message: e.message } });
    return 1;
  }
  try {
    out(await core.callTool(cmd, args));
    return 0;
  } catch (e) {
    out(errorPayload(e));
    return 1;
  }
}

main().then((code) => process.exit(code));
