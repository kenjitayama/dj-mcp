#!/usr/bin/env node
// dj-mcp: zero-dependency MCP stdio server (newline-delimited JSON-RPC 2.0) over lib/core.mjs.
import { createCore, errorPayload } from '../lib/core.mjs';
import { createInterface } from 'node:readline';
import { readFileSync } from 'node:fs';

const pkg = JSON.parse(readFileSync(new URL('../plugin.json', import.meta.url), 'utf8'));
const SUPPORTED = ['2025-11-25', '2025-06-18', '2025-03-26', '2024-11-05'];
const core = createCore();

const send = (msg) => process.stdout.write(JSON.stringify(msg) + '\n');
const log = (...a) => process.stderr.write(`[dj-mcp-server] ${a.join(' ')}\n`);

async function handle(msg) {
  const { id, method, params } = msg;
  const isRequest = id !== undefined && id !== null;
  try {
    switch (method) {
      case 'initialize': {
        const requested = params?.protocolVersion;
        return isRequest && send({
          jsonrpc: '2.0',
          id,
          result: {
            protocolVersion: SUPPORTED.includes(requested) ? requested : SUPPORTED[0],
            capabilities: { tools: { listChanged: false } },
            serverInfo: { name: pkg.name, version: pkg.version },
            instructions: 'dj-mcp: playback control and music search via the Spotify Web API. If a tool returns error.code "not_authorized", run auth_start and relay authorize_url to the user, then auth_complete with the pasted redirect URL. On "no_active_device", call get_devices then transfer_playback.',
          },
        });
      }
      case 'notifications/initialized':
      case 'notifications/cancelled':
        return;
      case 'ping':
        return isRequest && send({ jsonrpc: '2.0', id, result: {} });
      case 'tools/list':
        return send({ jsonrpc: '2.0', id, result: { tools: core.tools } });
      case 'tools/call': {
        const name = params?.name;
        try {
          const out = await core.callTool(name, params?.arguments || {});
          return send({ jsonrpc: '2.0', id, result: { content: [{ type: 'text', text: JSON.stringify(out, null, 2) }], isError: false } });
        } catch (e) {
          return send({ jsonrpc: '2.0', id, result: { content: [{ type: 'text', text: JSON.stringify(errorPayload(e), null, 2) }], isError: true } });
        }
      }
      default:
        if (isRequest) send({ jsonrpc: '2.0', id, error: { code: -32601, message: `Method not found: ${method}` } });
    }
  } catch (e) {
    log('handler error:', e?.message);
    if (isRequest) send({ jsonrpc: '2.0', id, error: { code: -32603, message: e?.message || 'Internal error' } });
  }
}

const pending = new Set();
const rl = createInterface({ input: process.stdin, crlfDelay: Infinity });
rl.on('line', (line) => {
  if (!line.trim()) return;
  let msg;
  try {
    msg = JSON.parse(line);
  } catch {
    return send({ jsonrpc: '2.0', id: null, error: { code: -32700, message: 'Parse error' } });
  }
  const batch = Array.isArray(msg) ? msg : [msg];
  for (const m of batch) {
    const p = handle(m).finally(() => pending.delete(p));
    pending.add(p);
  }
});
rl.on('close', async () => {
  await Promise.allSettled([...pending]);
  process.exit(0);
});
log(`ready (client_id from ${core.resolveClientId().source || 'NOT CONFIGURED'}, store ${core.configDir})`);
